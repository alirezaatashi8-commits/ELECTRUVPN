[Unit]
Description=ELECTRUVPN BETA Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/electruvpn/agent.env
ExecStart=/usr/local/bin/electruvpn-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/electruvpn /var/log /var/lib/electruvpn-agent

[Install]
WantedBy=multi-user.target
