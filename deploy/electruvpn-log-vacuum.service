[Unit]
Description=ELECTRUVPN hourly journal log cleanup
After=local-fs.target electruvpn.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/electruvpn/electruvpn.env
ExecStart=/opt/electruvpn/log-vacuum.sh
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/opt/electruvpn
ReadOnlyPaths=/etc/electruvpn
