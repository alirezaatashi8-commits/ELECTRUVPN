# Copy to /etc/electruvpn/electruvpn.env and edit before starting the service.

# Port the ElectruVPN web panel itself listens on (not the VPN ports).
ELECTRU_PANEL_PORT=2087

# Keep this enabled if the operator wants to open the panel through the same VPN/proxy configuration.
ELECTRU_PANEL_VPN_ACCESS=1
ELECTRU_PANEL_BIND_ADDR=0.0.0.0

# Optional: hide the panel behind a random path, e.g. /8f3ac9d2/
# Leave as "/" to serve at the domain root.
ELECTRU_BASE_PATH=/

# ===== Database =====
# Preferred: PostgreSQL (high concurrency). When set, SQLite is ignored.
# Example:
# ELECTRU_DB_DSN=host=127.0.0.1 user=electruvpn password=YOUR_STRONG_PASSWORD dbname=electruvpn port=5432 sslmode=disable TimeZone=UTC
ELECTRU_DB_DSN=

# Connection pool (PostgreSQL). Tune for concurrent dashboard + agents + subs.
ELECTRU_DB_MAX_OPEN=10
ELECTRU_DB_MAX_IDLE=3
ELECTRU_DB_CONN_MAX_LIFETIME_MIN=30

# Legacy SQLite path (only when ELECTRU_DB_DSN is empty).
ELECTRU_DB_PATH=/etc/electruvpn/electruvpn.db


# MUST be changed to a long random string in production.
# Generate one with: openssl rand -hex 32
ELECTRU_JWT_SECRET=change-me-in-production-please

# AES-256 master key for encrypting secrets at rest + signed subscriptions.
# Generate: openssl rand -hex 32
ELECTRU_CONFIG_ENCRYPTION_KEY=

# Path to the xray-core binary (install separately, see README).
ELECTRU_XRAY_BIN=/usr/local/bin/xray

# Where the panel writes the generated xray config.json.
ELECTRU_XRAY_CONFIG=/etc/electruvpn/xray-config.json

# Local-only port xray exposes its stats gRPC API on.
ELECTRU_XRAY_API_PORT=10085
# Loopback-only Clash API of sing-box, used for live speed / devices of Hysteria2, TUIC, Naive, AnyTLS, ShadowTLS, WireGuard (0 = off)
ELECTRU_SINGBOX_API_PORT=10086

# Optional: hostname/IP used in generated VLESS/VMess/Trojan/SS share links.
# Do NOT include the panel port. Example: vpn.example.com
ELECTRU_PUBLIC_HOST=vpn.example.com
# Optional explicit endpoints for family-specific client links
ELECTRU_PUBLIC_HOST_V4=203.0.113.10
# Last IPv4 kept in refreshed subscriptions during IP migration (managed by panel).
ELECTRU_PREVIOUS_PUBLIC_HOST_V4=
ELECTRU_PUBLIC_HOST_V6=2001:db8::10
# Optional DNS name used for generated VPN/config/subscription links. It may resolve to A and/or AAAA.
ELECTRU_PUBLIC_HOST_DOMAIN=vpn.example.com
# Optional separate subscription endpoint origins. Leave empty to use ELECTRU_SUBSCRIPTION_BASE_URL.
ELECTRU_SUBSCRIPTION_BASE_URL_V4=https://203.0.113.10
ELECTRU_SUBSCRIPTION_BASE_URL_V6=https://[2001:db8::10]
ELECTRU_SUBSCRIPTION_BASE_URL_DOMAIN=https://vpn.example.com

# Strict privacy mode. In strict mode client links never fall back to the panel Host header.
ELECTRU_SECURITY_MODE=strict

# Separate public HTTPS endpoint for subscription delivery (prefer a separate domain/CDN).
ELECTRU_SUBSCRIPTION_BASE_URL=https://sub.example.com

# Server-side encrypted DNS only; do not use the host/system resolver for proxy DNS.
# Preferred: set provider from Panel → Settings → DNS Provider (cloudflare|google|quad9|auto|custom).
# Env list is used when provider=auto.
ELECTRU_DNS_RESOLVERS=https+local://1.1.1.1/dns-query,https+local://8.8.8.8/dns-query

# sing-box binary/config for Hysteria2/TUIC/WireGuard/AnyTLS/ShadowTLS.
ELECTRU_SINGBOX_BIN=/usr/local/bin/sing-box
ELECTRU_SINGBOX_CONFIG=/etc/electruvpn/sing-box.json

# Optional Telegram alerts/test integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Automatic reliability backups (minimum interval is 15 minutes).
ELECTRU_BACKUP_INTERVAL_MIN=1440
ELECTRU_BACKUP_RETENTION=14
# Optional mounted remote/NFS/SFTP-sync directory for a second backup copy.
ELECTRU_BACKUP_REMOTE_DIR=

# Full-speed policy: no per-user Mbps shaping is enforced.
# Service-plan speed fields remain metadata only for compatibility.

# Optional Prometheus endpoint: GET <base path>/metrics with "Authorization: Bearer <token>".
# Disabled (404) while empty. Enable from the server with: electruvpn metrics enable
ELECTRU_METRICS_TOKEN=

# Geo data (geoip.dat/geosite.dat) auto-update source: iran (default, includes geoip:ir) or standard.
# A weekly systemd timer runs it; manual run: electruvpn geo update
ELECTRU_GEO_SOURCE=iran


# Auto-detect server public IP for share/subscription links when the host
# address is an IP (not a domain). Domains are never auto-changed.
# Set to 0 to disable. Default: enabled.
ELECTRU_AUTO_PUBLIC_IP=1
# ===== Docker Compose Postgres (used by docker-compose.yml) =====
# DSN is key=value — password MUST NOT contain spaces, quotes, \, or #.
# Generate a safe value:  openssl rand -hex 24
POSTGRES_USER=electruvpn
POSTGRES_PASSWORD=
POSTGRES_DB=electruvpn

# ===== Resource tuning (optional) =====
# Soft memory ceiling for the panel's own Go runtime (xray/sing-box are separate
# processes and are not affected). Leave unset on small VPSs unless you see
# memory pressure; a good value is ~50-60% of free RAM, e.g. 600MiB.
# GOMEMLIMIT=600MiB
# Go GC aggressiveness (default 100). Lower = less RAM, slightly more CPU.
# GOGC=100

# Days of hourly usage-snapshot history kept in the database (min 30, default 90).
# Only history rows are pruned; client usage counters are never touched.
# ELECTRU_SNAPSHOT_RETENTION_DAYS=90
